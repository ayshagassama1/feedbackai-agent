GEMINI_API_KEY=your-gemini-api-key

# Gemma (Vertex AI, Model Garden) — triage par item, optionnel
# Si absentes ou si l'endpoint ne répond pas, ingest_feedback bascule automatiquement sur
# Gemini (fallback obligatoire, voir agent/gemma_client.py et le README).
GCP_PROJECT_ID=your-gcp-project-id
GEMMA_ENDPOINT_ID=your-gemma-endpoint-id
GEMMA_LOCATION=us-central1

# GitHub Issues action externe de l'agent (création de tickets)
# Token à portée minimale (issues uniquement). GITHUB_REPO_MAP associe chaque project_id à un
# repo cible "owner/repo" (JSON).
GITHUB_TOKEN=your-github-token
GITHUB_REPO_MAP={"demo": "owner/repo-name"}

# Cycle autonome — POST /api/agent/run-cycle, jamais public. Deux mécanismes d'auth acceptés :
# - RUN_CYCLE_SECRET : secret partagé en en-tête X-Run-Cycle-Secret, pour un appel direct
#   (tests/débogage).
# - PUBSUB_PUSH_SERVICE_ACCOUNT / RUN_CYCLE_AUDIENCE : vérification du jeton OIDC émis par la
#   subscription push Pub/Sub (étape 3.2). RUN_CYCLE_AUDIENCE est l'URL complète de l'endpoint
#   une fois déployé (ex. https://xxx.run.app/api/agent/run-cycle).
RUN_CYCLE_SECRET=your-run-cycle-secret
PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-run-cycle-invoker@your-project.iam.gserviceaccount.com
RUN_CYCLE_AUDIENCE=https://your-service-url.run.app/api/agent/run-cycle

# CORS — origine(s) autorisées à appeler l'API, séparées par des virgules si plusieurs.
# Jamais "*" en prod (étape 5.1). Par défaut : proxy Vite en local uniquement.
FRONTEND_ORIGINS=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=feedbackai

# Frontend
VITE_PROJECT_ID=demo
VITE_API_URL=http://localhost:8000
